# ============================================================
#  Configuración del Agente RAG Corporativo
#  Copiá este archivo a ".env" y completá tus valores.
# ============================================================

# --- Proveedor de LLM y embeddings ---
# Opciones: "gemini" (por defecto) | "openai"
LLM_PROVIDER=gemini

# --- Credenciales (según el proveedor elegido) ---
# Gemini: obtené la key en https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=tu_api_key_de_google

# OpenAI: obtené la key en https://platform.openai.com/api-keys
OPENAI_API_KEY=tu_api_key_de_openai

# --- Modelos (dejá los valores por defecto si no sabés qué poner) ---
# Gemini
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2
# OpenAI
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Parámetros del RAG ---
CHUNK_SIZE=800              # Tamaño objetivo de cada fragmento (tokens aprox.)
CHUNK_OVERLAP=120           # Superposición entre fragmentos
TOP_K=5                     # Cantidad de fragmentos recuperados por consulta
MIN_RELEVANCE=0.53          # Similitud mínima para responder (calibrada con eval/)
RELEVANCE_MARGIN=0.08       # Sólo se usan y citan fragmentos a esta distancia del mejor

# --- Límites de uso (protegen la cuota de la API key; 0 = sin límite) ---
RATE_LIMIT_PER_CLIENT=15    # Preguntas por cliente (IP) en la ventana
RATE_LIMIT_WINDOW_MIN=10    # Ventana deslizante, en minutos
RATE_LIMIT_DAILY=300        # Llamadas al modelo por día entre todos los usuarios
MAX_QUESTION_CHARS=500      # Largo máximo de una pregunta

# --- Empresa ---
# Carpeta del perfil (perfil.toml, documentos/ y set de evaluación).
PERFIL=perfiles/techretail

# --- Demo pública ---
# 1 muestra el botón "Probar como empleado" (sólo con datos ficticios).
EMPLEADO_DEMO=1
# Video que se ofrece cuando se agota la cuota de la API (opcional).
# VIDEO_DEMO_URL=https://...
# Minutos que se guarda la respuesta a una pregunta sugerida (0 = no se guarda).
CACHE_SUGERENCIAS_MIN=360

# --- Rutas ---
# Por defecto, la carpeta documentos/ del perfil.
# DOCS_DIR=perfiles/techretail/documentos
# Por defecto: data/chroma y logs/consultas.jsonl. La imagen Docker usa /data,
# así que no las definas si usás este archivo con docker run --env-file.
# CHROMA_DIR=data/chroma
# LOG_FILE=logs/consultas.jsonl
